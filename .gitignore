# Python build and import artifacts.  At the REPOSITORY root, not per package: the per-package .gitignore files
# below only cover their own subtree, and the consolidation on 2026-09-03 moved several packages into trees that
# had none -- 200 .pyc files were committed that way before anyone noticed.
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.coverage
.coverage.*

# Secrets.  A .env holds real credentials -- NB_SETUP_KEY for the netbird overlay, the endpoint of a running
# robot -- and belongs beside a committed .env.example, never in the history.  At the REPOSITORY root for the
# same reason as the artifacts above: until 2026-09-03 only deploy/offboard and offboard-base
# ignored the name, so any other tree that grew a .env would have committed it.
.env

# macOS Finder metadata
.DS_Store

# colcon
install/
log/

# The owner's local material: the Onshape export of the RG6 (gripper_rg6.gltf), not ours to redistribute, and
# rg6_details_mesh.py, which wrote the three detail meshes under src/rg6_description from it.  The meshes are committed
# and nothing regenerates them; the script's last versioned state is tools 5642307.
/.local/
